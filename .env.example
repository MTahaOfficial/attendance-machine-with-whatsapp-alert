# Copy this file to .env and edit. Every line is optional.

# PostgreSQL. The default matches `npm run db:embedded` and the included docker-compose.yml.
# The database itself is created automatically if it does not exist.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meridian

# Platform-admin login, created on the first start (change before the first start!)
ADMIN_EMAIL=admin@meridian.local
ADMIN_PASSWORD=admin123

# Ports. HTTP is for the laptop, HTTPS (self-signed) is what the tablet camera needs.
PORT=4000
HTTPS_PORT=4443
HTTPS=1

# Time zone used for "today" and the late rule.
APP_TZ=Asia/Karachi

# Optional: fixed signing secret for logins (a random one is generated and kept in server/data otherwise)
# JWT_SECRET=change-me
