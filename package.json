{
  "name": "meridian",
  "private": true,
  "version": "2.0.0",
  "description": "Meridian Attendance - face-recognition attendance with a platform-admin portal and a company portal",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:embedded": "node server/embedded-db.js",
    "seed": "node server/seed.js",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.6.0",
    "selfsigned": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "embedded-postgres": "17.11.0-beta.19"
  }
}
