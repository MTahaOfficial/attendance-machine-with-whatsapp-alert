{
  "name": "Meridian attendance messages",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "attendance",
        "options": {}
      },
      "name": "Meridian webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "meridian-attendance"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? $input.first().json;\nreturn [{ json: {\n  text: b.message,\n  group: b.participant?.group || '',\n  event: b.event,\n  name: b.participant?.name,\n  company: b.company || ''\n} }];"
      },
      "name": "Read message and group",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3100/send",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{ $json.group }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send WhatsApp message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    }
  ],
  "connections": {
    "Meridian webhook": {
      "main": [
        [
          {
            "node": "Read message and group",
            "type": "main",
            "index": 0
          }
        ]
      ]
